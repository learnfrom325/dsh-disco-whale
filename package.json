{
  "name": "dsh-disco-whale",
  "version": "0.5.2",
  "description": "DSH 桌面端/网页端的「鲸鱼蹦迪」彩蛋插件：新宿梗先由模型在聊天里转场，再播放视频；28 秒和 88 秒 Q 版 DeepSeek 娘释放虚式「茈」击中 Q 版龙娘，41 秒双方展开领域。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "easter-egg",
    "disco",
    "whale"
  ],
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "check": "node --check lib/index.js && node --check assets/disco-widget.js",
    "test": "node tests/smoke.cjs && node tests/host.mjs"
  },
  "icon": "./assets/icon.png",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learnfrom325/dsh-disco-whale.git"
  },
  "homepage": "https://github.com/learnfrom325/dsh-disco-whale#readme",
  "bugs": {
    "url": "https://github.com/learnfrom325/dsh-disco-whale/issues"
  },
  "license": "MIT"
}
