{
  "name": "dsh-disco-whale",
  "version": "0.1.1",
  "description": "DSH 桌面端/网页端的「鲸鱼蹦迪」彩蛋插件：发送「欧耶耶」后，屏幕亮起迪斯科舞厅灯光、小鲸鱼左右摇摆蹦迪、旁边立起音响、气泡轮播《朋友的酒》歌词，并把你后续那条助手回复换成歌词；发「？」则获得一句严肃提醒。音乐可自备，缺省用内置合成音。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "easter-egg",
    "disco",
    "whale"
  ],
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "check": "node --check lib/index.js && node --check assets/disco-widget.js",
    "test": "node tests/smoke.cjs"
  },
  "icon": "./assets/icon.png",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learnfrom325/dsh-disco-whale.git"
  },
  "homepage": "https://github.com/learnfrom325/dsh-disco-whale#readme",
  "bugs": {
    "url": "https://github.com/learnfrom325/dsh-disco-whale/issues"
  },
  "license": "MIT"
}
